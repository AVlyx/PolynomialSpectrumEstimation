\@writefile{lof}{\contentsline {figure}{\numberline {G.1}{\ignorespaces Lower bounds on the entanglement of formation $E_F$ for different PPT and NPT states, from the SDP with embedded LP. Bars: lower bounds from the simplified hierarchy at the levels $(k,m)$ shown in the legend. Markers: upper bounds from the decomposition extracted from the SDP solution at $k=m=3$ (orange diamonds) and from HJW gradient descent over decompositions (black crosses). All values are divided by the best upper bound UB, printed above each state. Here, UB is the exact convex roof for two qubits (marked $^*$), and the lowest of the two upper bounds otherwise. Notice that the gap between upper and lower bounds decreases with the hierarchy level.}}{35}{figure.G.1}\protected@file@percent }
\newlabel{fig:EoF}{{G.1}{35}{Lower bounds on the entanglement of formation $E_F$ for different PPT and NPT states, from the SDP with embedded LP. Bars: lower bounds from the simplified hierarchy at the levels $(k,m)$ shown in the legend. Markers: upper bounds from the decomposition extracted from the SDP solution at $k=m=3$ (orange diamonds) and from HJW gradient descent over decompositions (black crosses). All values are divided by the best upper bound UB, printed above each state. Here, UB is the exact convex roof for two qubits (marked $^*$), and the lowest of the two upper bounds otherwise. Notice that the gap between upper and lower bounds decreases with the hierarchy level}{figure.G.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {G.2}{\ignorespaces Lower bounds on the linear entropy for different PPT and NPT states. Bars: lower bounds from the simplified hierarchy at the levels $(k,m)$ shown in the legend. Markers: upper bounds from the decomposition extracted from the SDP solution at $k=m=3$ (orange diamonds) and from HJW gradient descent over decompositions (black crosses). All values are divided by the best upper bound UB, printed above each state. Here, UB is the exact convex roof for two qubits (marked $^*$), and the lowest of the two upper bounds otherwise.}}{35}{figure.G.2}\protected@file@percent }
\newlabel{fig:namedLinearEntropy}{{G.2}{35}{Lower bounds on the linear entropy for different PPT and NPT states. Bars: lower bounds from the simplified hierarchy at the levels $(k,m)$ shown in the legend. Markers: upper bounds from the decomposition extracted from the SDP solution at $k=m=3$ (orange diamonds) and from HJW gradient descent over decompositions (black crosses). All values are divided by the best upper bound UB, printed above each state. Here, UB is the exact convex roof for two qubits (marked $^*$), and the lowest of the two upper bounds otherwise}{figure.G.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {G.3}{\ignorespaces Lower bounds on the Vidal monotone $E_1$ for different PPT and NPT states, from the SDP with embedded LP. Bars: lower bounds from the simplified hierarchy at the levels $(k,m)$ shown in the legend. Markers: upper bounds from the decomposition extracted from the SDP solution at $k=m=3$ (orange diamonds) and from HJW gradient descent over decompositions (black crosses). All values are divided by the best upper bound UB, printed above each state. Here, UB is the exact convex roof for two qubits (marked $^*$), and the lowest of the two upper bounds otherwise.}}{36}{figure.G.3}\protected@file@percent }
\newlabel{fig:Vidal}{{G.3}{36}{Lower bounds on the Vidal monotone $E_1$ for different PPT and NPT states, from the SDP with embedded LP. Bars: lower bounds from the simplified hierarchy at the levels $(k,m)$ shown in the legend. Markers: upper bounds from the decomposition extracted from the SDP solution at $k=m=3$ (orange diamonds) and from HJW gradient descent over decompositions (black crosses). All values are divided by the best upper bound UB, printed above each state. Here, UB is the exact convex roof for two qubits (marked $^*$), and the lowest of the two upper bounds otherwise}{figure.G.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {G.4}{\ignorespaces  Polynomials $P\leq F$ extracted from the SDP with embedded LP for different $2$-qubit states. For each state, this is the polynomial that yields the best bound on the convex roof on the grid, at level $(3,4)$ for $E_F$ (a) and at level $(3,3)$ for $E_1$ (b). Here we show that the LP is adaptive depending on the state and there is not a single polynomial that yields the best bound on the convex roof for all states at the same level. The states used are $\{$ Werner $2\times 2$: singlet weight $p=0.8$; Gisin: $\lambda =0.9$, $\theta =\pi /8$; MEMS: $C=0.8$; Bell + $\ket {01}$: $p=0.6$ $\}$. The polynomials are shown as a function of the entanglement spectrum $\alpha = (\alpha _1, \alpha _2) = (\alpha _1, 1-\alpha _1)$.}}{36}{figure.G.4}\protected@file@percent }
\newlabel{fig:polynomials}{{G.4}{36}{Polynomials $P\leq F$ extracted from the SDP with embedded LP for different $2$-qubit states. For each state, this is the polynomial that yields the best bound on the convex roof on the grid, at level $(3,4)$ for $E_F$ (a) and at level $(3,3)$ for $E_1$ (b). Here we show that the LP is adaptive depending on the state and there is not a single polynomial that yields the best bound on the convex roof for all states at the same level. The states used are $\{$ Werner $2\times 2$: singlet weight $p=0.8$; Gisin: $\lambda =0.9$, $\theta =\pi /8$; MEMS: $C=0.8$; Bell + $\ket {01}$: $p=0.6$ $\}$. The polynomials are shown as a function of the entanglement spectrum $\a = (\a _1, \a _2) = (\a _1, 1-\a _1)$}{figure.G.4}{}}
