\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Grid discretization of the simplex of spectra for $d_A=3$. (a) Different values of $F(\alpha )$ are denoted by different colors. The dots denote the grid $G$, separated by a certain distance $1/m$. Since entanglement measures are symmetric functions on the spectrum, only the points with $\alpha _1\geq \alpha _2\geq \alpha _3$ (dashed region, filled dots) need to be imposed. (b) Cut along a one-parameter family of spectra. Although $P^*\leq F$ holds at all grid points, it is possible that $P^*>F$ between any two points by a value $\epsilon $. This value decreases as we refine the grid.}}{15}{figure.5.1}\protected@file@percent }
\newlabel{fig:grid}{{5.1}{15}{Grid discretization of the simplex of spectra for $d_A=3$. (a) Different values of $F(\alpha )$ are denoted by different colors. The dots denote the grid $G$, separated by a certain distance $1/m$. Since entanglement measures are symmetric functions on the spectrum, only the points with $\alpha _1\geq \alpha _2\geq \alpha _3$ (dashed region, filled dots) need to be imposed. (b) Cut along a one-parameter family of spectra. Although $P^*\leq F$ holds at all grid points, it is possible that $P^*>F$ between any two points by a value $\epsilon $. This value decreases as we refine the grid}{figure.5.1}{}}
\newlabel{thm:non-polyHier}{{5.1}{15}{}{theorem.5.1}{}}
\newlabel{eq:vonNeumann}{{5.3}{15}{Non-polynomial measures via linear programming}{equation.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Best lower bound on the entanglement of formation $E_F$ for different PPT and NPT states, from the SDP with embedded LP at level $(k,m)=(2,4)$, divided by the best upper bound UB printed above each state. For two qubits, UB is the exact convex roof (marked $^*$). All levels of the hierarchy and both upper bounds, for more states, are shown in Fig.~\ref {fig:EoF}.}}{16}{figure.5.2}\protected@file@percent }
\newlabel{fig:EoFmain}{{5.2}{16}{Best lower bound on the entanglement of formation $E_F$ for different PPT and NPT states, from the SDP with embedded LP at level $(k,m)=(2,4)$, divided by the best upper bound UB printed above each state. For two qubits, UB is the exact convex roof (marked $^*$). All levels of the hierarchy and both upper bounds, for more states, are shown in Fig.~\ref {fig:EoF}}{figure.5.2}{}}
