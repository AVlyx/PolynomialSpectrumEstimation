\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Lower bounds on the entanglement of formation $E_F$ for different PPT and NPT states, from the SDP with embedded LP. Bars: lower bounds from the simplified hierarchy at the levels $(k,m)$ shown in the legend. Markers: upper bounds from the decomposition extracted from the SDP solution at $k=m=3$ (orange diamonds) and from HJW gradient descent over decompositions (black crosses). All values are divided by the best upper bound UB, printed above each state. Here, UB is the exact convex roof for two qubits (marked $^*$), and the lowest of the two upper bounds otherwise. Notice that the gap between upper and lower bounds decreases with the hierarchy level.}}{23}{figure.5}\protected@file@percent }
\newlabel{fig:EoF}{{5}{23}{Lower bounds on the entanglement of formation $E_F$ for different PPT and NPT states, from the SDP with embedded LP. Bars: lower bounds from the simplified hierarchy at the levels $(k,m)$ shown in the legend. Markers: upper bounds from the decomposition extracted from the SDP solution at $k=m=3$ (orange diamonds) and from HJW gradient descent over decompositions (black crosses). All values are divided by the best upper bound UB, printed above each state. Here, UB is the exact convex roof for two qubits (marked $^*$), and the lowest of the two upper bounds otherwise. Notice that the gap between upper and lower bounds decreases with the hierarchy level}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Lower bounds on the linear entropy for different PPT and NPT states. Bars: lower bounds from the simplified hierarchy at the levels $(k,m)$ shown in the legend. Markers: upper bounds from the decomposition extracted from the SDP solution at $k=m=3$ (orange diamonds) and from HJW gradient descent over decompositions (black crosses). All values are divided by the best upper bound UB, printed above each state. Here, UB is the exact convex roof for two qubits (marked $^*$), and the lowest of the two upper bounds otherwise.}}{23}{figure.6}\protected@file@percent }
\newlabel{fig:namedLinearEntropy}{{6}{23}{Lower bounds on the linear entropy for different PPT and NPT states. Bars: lower bounds from the simplified hierarchy at the levels $(k,m)$ shown in the legend. Markers: upper bounds from the decomposition extracted from the SDP solution at $k=m=3$ (orange diamonds) and from HJW gradient descent over decompositions (black crosses). All values are divided by the best upper bound UB, printed above each state. Here, UB is the exact convex roof for two qubits (marked $^*$), and the lowest of the two upper bounds otherwise}{figure.6}{}}
