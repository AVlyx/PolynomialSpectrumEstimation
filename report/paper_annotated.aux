\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces LOCC convertibility from the pure state $\ket {\psi }$ with entanglement spectrum $(0.6,0.3,0.1)$ to the two-qutrit states $\rho (p,\theta )=p\dyad {\Phi _3}+(1-p)\dyad {\chi _\theta }$, with $\ket {\Phi _3}$ maximally entangled and $\ket {\chi _\theta }=\cos \theta \ket {00}+\sin \theta \ket {11}$, from the SDP of Eq.~\eqref  {eq:LOCCminmaxt} at level $(k,m)=(3,4)$.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:locc}{{4}{12}{LOCC convertibility from the pure state $\ket {\psi }$ with entanglement spectrum $(0.6,0.3,0.1)$ to the two-qutrit states $\rho (p,\theta )=p\dyad {\Phi _3}+(1-p)\dyad {\chi _\theta }$, with $\ket {\Phi _3}$ maximally entangled and $\ket {\chi _\theta }=\cos \theta \ket {00}+\sin \theta \ket {11}$, from the SDP of Eq.~\eqref {eq:LOCCminmaxt} at level $(k,m)=(3,4)$}{figure.4}{}}
